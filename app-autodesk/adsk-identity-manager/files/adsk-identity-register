#!/usr/bin/env bash
set -euo pipefail

identity=/opt/Autodesk/AdskIdentityManager/Current/AdskIdentityManager
[[ -x ${identity} ]] || { echo "Autodesk Identity Manager is not installed" >&2; exit 1; }
command -v xdg-mime >/dev/null || { echo "xdg-mime is required" >&2; exit 1; }
register_status=0
"${identity}" --register || register_status=$?
appdir=${XDG_DATA_HOME:-${HOME}/.local/share}/applications
mkdir -p "${appdir}"
mkdir -p "${XDG_CONFIG_HOME:-${HOME}/.config}"
desktop=${appdir}/com.autodesk.AdskIdentityManager.desktop
if [[ ! -s ${desktop} ]]; then
  cat >"${desktop}" <<EOF
[Desktop Entry]
Type=Application
Name=Autodesk Identity Manager
Exec=${identity} %U
NoDisplay=true
MimeType=x-scheme-handler/adskidmgr;
Terminal=false
EOF
else
  sed -i "s#^Exec=.*#Exec=${identity} %U#" "${desktop}"
fi
if command -v update-desktop-database >/dev/null; then
  update-desktop-database "${appdir}" >/dev/null 2>&1 || true
fi
xdg-mime default "$(basename "${desktop}")" x-scheme-handler/adskidmgr
echo "Autodesk Identity Manager registered for ${USER}"
if (( register_status != 0 )); then
  echo "Identity Manager registration command failed with status ${register_status}; desktop callback was installed" >&2
  exit "${register_status}"
fi
